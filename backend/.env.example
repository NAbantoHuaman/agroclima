# Copiar este archivo a `backend/.env` y colocar tus credenciales locales.
# NUNCA subas `backend/.env` a GitHub ni lo pegues en capturas o chats.

# 1. OpenTopography (SRTM GL1 30 m / Copernicus DEM 30 m)
# Obtener en: https://portal.opentopography.org/requestService?service=api
OPENTOPOGRAPHY_API_KEY=

# 2. NASA Earthdata Login (para SMAP, ECOSTRESS, GPM via AppEEARS / Earthdata)
# Token largo en: https://urs.earthdata.nasa.gov/ (Generate Token)
EARTHDATA_TOKEN=
# Usuario y contraseña de Earthdata (necesarios si usas la API por lotes de AppEEARS /login)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# 3. Copernicus Data Space Ecosystem - CDSE (Sentinel-2 NDVI 10 m)
# Obtener en Sentinel Hub Dashboard -> User Settings -> OAuth clients:
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# 4. Google Gemini API (Copiloto de Voz IA inteligente)
# Obtener gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
